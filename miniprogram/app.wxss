/* =========================================================
   app.wxss —— 全局设计系统
   照搬 H5 版《合卡 24》的「糖果街机」基调：
     · 奶油纸面 + 两团糖果光晕
     · 牌是实体砖：白面 + 厚底边 + 落地阴影
     · 按钮/圆球用厚底边做出「能按到底」的手感
   牌面样式放这里，主界面和游戏页共用同一套 .card
   ========================================================= */

page {
  /* ---------- 墨色 ---------- */
  --text: #12312a;
  --text-dim: #4d6f65;
  --text-3: #7d9a90;
  --ink: #0b2a21;

  /* ---------- 糖果色 ---------- */
  --mint: #17c99a;
  --mint-hi: #7defc9;
  --mint-deep: #0b8f6d;
  --coral: #ff7a6b;
  --coral-hi: #ffb3a8;
  --coral-deep: #d33b2c;
  --amber: #ffc23d;
  --amber-hi: #ffdd93;
  --amber-deep: #c98a10;
  --sky: #4aa8ff;
  --sky-hi: #a5d4ff;
  --sky-deep: #1668c9;
  --red: #d0342e;

  /* ---------- 结构 ---------- */
  --line: rgba(18, 49, 42, 0.1);
  --line-2: rgba(18, 49, 42, 0.16);

  background-color: #f2fbf7;
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text {
  box-sizing: border-box;
}

/* =========================================================
   页面外壳：奶油纸面 + 两团慢慢漂的糖果光晕
   光晕用 radial-gradient 做软边，不挂 filter:blur（小程序上太贵）
   ========================================================= */

.shell {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background-color: #f2fbf7;
  background-image: linear-gradient(180deg, #f8fdfa 0%, #eefaf4 100%);
}

.glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}

.glow--a {
  top: -34vmax;
  left: -30vmax;
  width: 82vmax;
  height: 82vmax;
  background: radial-gradient(circle, rgba(23, 201, 154, 0.34), rgba(23, 201, 154, 0) 68%);
  animation: driftA 26s ease-in-out infinite alternate;
}

.glow--b {
  right: -32vmax;
  bottom: -38vmax;
  width: 82vmax;
  height: 82vmax;
  background: radial-gradient(circle, rgba(74, 168, 255, 0.26), rgba(74, 168, 255, 0) 68%);
  animation: driftB 34s ease-in-out infinite alternate;
}

@keyframes driftA {
  from { transform: translate(0, 0) scale(1); }
  to { transform: translate(6vmax, 5vmax) scale(1.12); }
}

@keyframes driftB {
  from { transform: translate(0, 0) scale(1); }
  to { transform: translate(-7vmax, -4vmax) scale(0.92); }
}

/* =========================================================
   品牌砖：左半薄荷写 24，右半琥珀写 Game
   纯 CSS 拼出来，不用图片，任何尺寸都清晰
   ========================================================= */

.logo {
  display: flex;
  flex: 0 0 auto;
  border-radius: 11px;
  transform: rotate(-3deg);
}

.logo__half {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 34px;
}

.logo__half--mint {
  width: 48px;
  border-radius: 11px 0 0 11px;
  background: linear-gradient(160deg, #b6ffe6 0%, #7defc9 45%, #17c99a 100%);
  box-shadow: 0 4px 0 #0b8f6d;
}

.logo__half--warm {
  width: 56px;
  border-radius: 0 11px 11px 0;
  background: linear-gradient(150deg, #ffeab6 0%, #ffdd93 36%, #ffc23d 100%);
  box-shadow: 0 4px 0 #c98a10;
}

.logo__t {
  font-size: 20px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -0.6px;
  color: var(--ink);
}

.logo__t--w {
  font-size: 17px;
  letter-spacing: -0.4px;
}

/* =========================================================
   卡牌：H5 版一比一还原
   白面渐变 + 5px 厚底边 + 落地阴影 + 左上高光 + 1.5px 墨线牌沿
   尺寸与字号由 JS 按屏宽算，这里只管长相
   ========================================================= */

.card {
  position: relative;
  border-radius: 20px;
  background: linear-gradient(177deg, #ffffff 0%, #fbfdfc 62%, #f4faf7 100%);
  box-shadow: 0 5px 0 #cbdad3, 0 16px 28px rgba(18, 49, 42, 0.18);
  color: #22303a;
  transform-origin: 50% 60%;
  transition: box-shadow 0.22s cubic-bezier(0.22, 1.4, 0.36, 1),
    transform 0.22s cubic-bezier(0.22, 1.4, 0.36, 1),
    filter 0.22s;
}

.card--fill {
  width: 100%;
  height: 100%;
}

/* 红桃/方块：整张牌的字都变红 */
.card--red {
  color: var(--red);
}

/* 左上角一小块高光，纸面看起来是「凸」的 */
.card__glow {
  position: absolute;
  left: 0;
  top: 0;
  width: 62%;
  height: 46%;
  border-radius: 20px;
  background: radial-gradient(120% 120% at 0% 0%,
    rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0) 62%);
  pointer-events: none;
}

/* 牌沿：一圈很淡的墨线 */
.card__edge {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 20px;
  border: 1.5px solid rgba(18, 49, 42, 0.09);
  pointer-events: none;
}

/* 四角点数：左上正写，右下转 180° */
.card__corner {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1;
  font-weight: 800;
}

.card__corner--br {
  transform: rotate(180deg);
}

.card__v,
.card__s {
  line-height: 1;
}

.card__v {
  font-weight: 800;
}

/* 牌心：一个大数字占满整张牌 */
.card__center {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -1.5px;
}

/* ---------- 牌的六种状态 ---------- */

/* 点选第一张：抬起来 + 薄荷环 */
.card.is-selected {
  transform: translateY(-7px) rotate(-1deg);
  box-shadow: 0 0 0 3px var(--mint), 0 9px 0 #cfe6db,
    0 20px 32px rgba(11, 143, 109, 0.24);
}

/* 已合上、正在选运算符：琥珀呼吸 */
.card.is-pending {
  box-shadow: 0 0 0 3px var(--amber), 0 0 28px rgba(255, 194, 61, 0.55),
    0 9px 0 #e6dcc4;
  animation: pendingPulse 1.1s ease-in-out infinite;
}

/* 松手会落在它身上：薄荷呼吸 */
.card.is-target {
  box-shadow: 0 0 0 3px var(--mint), 0 0 30px rgba(23, 201, 154, 0.5),
    0 5px 0 #cbdad3, 0 16px 28px rgba(18, 49, 42, 0.18);
  animation: targetPulse 0.85s ease-in-out infinite;
}

/* 提示：一对牌同时亮 */
.card.is-hint {
  animation: hintPulse 0.9s ease-in-out infinite;
}

/* 通关：金环 + 外发光 */
.card.is-won {
  box-shadow: 0 0 0 4px var(--amber), 0 0 60px rgba(255, 194, 61, 0.72),
    0 5px 0 #cbdad3, 0 16px 28px rgba(18, 49, 42, 0.18);
  animation: winPulse 1.2s ease-in-out infinite;
}

/* 没凑到 24：褪色 + 摇头 */
.card.is-lost {
  filter: grayscale(0.45) brightness(0.97);
  animation: lostShake 0.5s ease-in-out;
}

@keyframes pendingPulse {
  0%, 100% {
    box-shadow: 0 0 0 3px rgba(255, 194, 61, 0.95), 0 0 22px rgba(255, 194, 61, 0.4),
      0 9px 0 #e6dcc4;
  }
  50% {
    box-shadow: 0 0 0 5px rgba(255, 194, 61, 0.5), 0 0 34px rgba(255, 194, 61, 0.6),
      0 9px 0 #e6dcc4;
  }
}

@keyframes targetPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.035); }
}

@keyframes hintPulse {
  0%, 100% {
    box-shadow: 0 0 0 3px var(--mint), 0 0 18px rgba(23, 201, 154, 0.42),
      0 5px 0 #cbdad3, 0 16px 28px rgba(18, 49, 42, 0.18);
  }
  50% {
    box-shadow: 0 0 0 6px rgba(23, 201, 154, 0.35), 0 0 34px rgba(23, 201, 154, 0.6),
      0 5px 0 #cbdad3, 0 16px 28px rgba(18, 49, 42, 0.18);
  }
}

@keyframes winPulse {
  0%, 100% {
    box-shadow: 0 0 0 4px var(--amber), 0 0 46px rgba(255, 194, 61, 0.6),
      0 5px 0 #cbdad3, 0 16px 28px rgba(18, 49, 42, 0.18);
  }
  50% {
    box-shadow: 0 0 0 8px rgba(255, 194, 61, 0.45), 0 0 74px rgba(255, 194, 61, 0.85),
      0 5px 0 #cbdad3, 0 16px 28px rgba(18, 49, 42, 0.18);
  }
}

@keyframes lostShake {
  0%, 100% { transform: translateX(0); }
  22% { transform: translateX(-5px) rotate(-1.4deg); }
  55% { transform: translateX(4px) rotate(1.2deg); }
  80% { transform: translateX(-2px); }
}

/* 发牌 / 新牌登场：从上方带角度砸下来
   动画挂在 .grab 上（不是 .card），这样 .card 的 transform
   还能留给「选中抬起」这些状态，互不打架 */
.grab.is-spawn {
  animation: spawn 0.44s cubic-bezier(0.2, 1.25, 0.3, 1) backwards;
}

@keyframes spawn {
  from {
    transform: translateY(-44px) rotate(-9deg) scale(0.72);
    opacity: 0;
  }
  to {
    transform: translateY(0) rotate(0deg) scale(1);
    opacity: 1;
  }
}

/* =========================================================
   按钮：厚底边，按下去会沉
   ========================================================= */

.tool {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 3px;
  min-height: 52px;
  padding: 6px 5px 5px;
  border-radius: 16px;
  border: 1px solid rgba(18, 49, 42, 0.18);
  background: linear-gradient(180deg, #ffffff 0%, #e6f5ee 100%);
  box-shadow: 0 3px 0 rgba(18, 49, 42, 0.16), 0 8px 16px rgba(18, 49, 42, 0.09),
    0 1px 0 #ffffff inset;
  color: var(--text);
  transition: transform 0.14s cubic-bezier(0.34, 1.56, 0.64, 1),
    box-shadow 0.16s;
}

.tool__cap {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.3px;
  line-height: 1;
  color: var(--text-dim);
  white-space: nowrap;
}

.tool__ico {
  font-size: 19px;
  line-height: 1;
  color: var(--mint-deep);
}

/* 按下态：由 hover-class 触发 */
.is-press {
  transform: translateY(3px) !important;
  box-shadow: 0 0 0 rgba(0, 0, 0, 0), 0 3px 8px rgba(18, 49, 42, 0.14) !important;
}

.tool.is-off {
  opacity: 0.45;
}

.tool__ico.is-mute {
  color: var(--text-3);
  text-decoration: line-through;
}

/* =========================================================
   通用文字按钮（弹层里用）
   ========================================================= */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 11px 18px;
  border-radius: 14px;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.2px;
  color: var(--text);
  background: linear-gradient(180deg, #ffffff, #f1f9f6);
  border: 1px solid var(--line-2);
  box-shadow: 0 3px 0 rgba(18, 49, 42, 0.12), 0 8px 16px rgba(18, 49, 42, 0.1);
  transition: transform 0.14s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.16s;
}

.btn--primary {
  color: var(--ink);
  background: linear-gradient(180deg, var(--mint-hi) 0%, var(--mint) 70%, #12bd8f 100%);
  border-color: rgba(11, 143, 109, 0.5);
  box-shadow: 0 4px 0 var(--mint-deep), 0 10px 20px rgba(11, 143, 109, 0.28),
    0 2px 0 rgba(255, 255, 255, 0.6) inset;
}

.btn.is-press {
  transform: translateY(4px) !important;
  box-shadow: 0 0 0 rgba(0, 0, 0, 0), 0 3px 9px rgba(18, 49, 42, 0.16) !important;
}

/* =========================================================
   弹层：半透明墨绿薄雾 + 白瓷卡
   ========================================================= */

.modal {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(18, 49, 42, 0.42);
}

.modal__card {
  position: relative;
  width: 100%;
  max-width: 400px;
  max-height: 82vh;
  padding: 20px;
  border-radius: 26px;
  background: linear-gradient(180deg, #ffffff 0%, #f8fdfb 100%);
  border: 1px solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 30px 60px rgba(18, 49, 42, 0.3), 0 4px 0 #e3eee8;
  animation: modalIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: translateY(16px) scale(0.94);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.modal__title {
  margin-bottom: 12px;
  font-size: 19px;
  font-weight: 900;
  letter-spacing: 0.3px;
}

.modal__actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
  margin-top: 18px;
}

/* 说明正文 */
.howto {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.howto__li {
  display: flex;
  align-items: flex-start;
  gap: 9px;
}

.howto__no {
  flex: 0 0 auto;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: linear-gradient(180deg, #e9fff7, #ccf6e6);
  border: 1px solid rgba(23, 201, 154, 0.45);
  font-size: 11px;
  font-weight: 900;
  line-height: 18px;
  text-align: center;
  color: var(--mint-deep);
}

.howto__tx {
  flex: 1;
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--text-dim);
}

.howto__tx .b {
  color: var(--text);
  font-weight: 800;
}

.howto__tip {
  margin-top: 14px;
  padding: 9px 12px;
  border-radius: 12px;
  font-size: 12.5px;
  line-height: 1.7;
  color: var(--text-dim);
  background: #eaf7f1;
  border: 1px dashed rgba(11, 143, 109, 0.28);
}

.howto__tip .b {
  color: var(--text);
  font-weight: 800;
}

/* 尊重系统「减少动态效果」：光晕停漂 */
@media (prefers-reduced-motion: reduce) {
  .glow--a,
  .glow--b {
    animation: none;
  }
}
