/* =========================================================
   game.wxss —— 主玩法页样式
   注意 WXSS 限制：不能用 * 通配符、不能用 :has()，
   拖拽用的 transform 完全留给 WXS，这里不要碰 .card 的 transform
   ========================================================= */

.stage {
  min-height: 100vh;
  padding: 0 16px 32px;
  display: flex;
  flex-direction: column;
}

/* ---------- 顶部 ---------- */

.hud {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 4px 0;
}

.hud__back {
  width: 34px;
  height: 34px;
  border-radius: 999px;
  background: #ffffff;
  border: 1px solid #dbe7e1;
  color: #0b8f6d;
  font-size: 22px;
  line-height: 30px;
  text-align: center;
  margin-right: 10px;
}

.hud__info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.hud__level {
  font-size: 20px;
  font-weight: 500;
  color: #123c31;
  line-height: 1.3;
}

.hud__sol {
  font-size: 12px;
  color: #6b8a80;
  margin-top: 2px;
}

.hud__retry {
  font-size: 14px;
  color: #0b8f6d;
  padding: 6px 14px;
  border-radius: 999px;
  background: #ffffff;
  border: 1px solid #dbe7e1;
}

.tip {
  font-size: 13px;
  color: #6b8a80;
  padding: 10px 4px 0;
}

/* ---------- 牌桌 ---------- */

.board {
  position: relative;
  width: 100%;
  margin-top: 8px;
}

.slot {
  position: absolute;
  transition: left 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
              top 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.card {
  width: 100%;
  height: 100%;
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid #e6f0eb;
  box-shadow: 0 6px 16px rgba(18, 60, 49, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  will-change: transform;
  animation: cardIn 0.22s ease-out;
}

@keyframes cardIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.card__num {
  font-size: 34px;
  font-weight: 500;
  color: #123c31;
  line-height: 1;
  animation: numPop 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.3);
}

@keyframes numPop {
  from { transform: scale(0.55); }
  to { transform: scale(1); }
}

.card--sm .card__num {
  font-size: 22px;
}

/* ---------- 算式回显 ---------- */

.expr {
  margin-top: 12px;
  text-align: center;
  font-size: 15px;
  color: #0b8f6d;
  background: #ffffff;
  border: 1px solid #dbe7e1;
  border-radius: 12px;
  padding: 10px 16px;
  align-self: center;
}

/* ---------- 死局提示 ---------- */

.dead {
  margin-top: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}

.dead__txt {
  font-size: 14px;
  color: #b4553f;
}

.dead__btn {
  font-size: 14px;
  color: #ffffff;
  background: #ff7a6b;
  padding: 6px 16px;
  border-radius: 999px;
}

/* ---------- 遮罩与面板 ---------- */

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(18, 60, 49, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.panel {
  width: 78%;
  max-width: 320px;
  background: #ffffff;
  border-radius: 20px;
  padding: 24px 20px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: panelIn 0.24s cubic-bezier(0.2, 0.9, 0.3, 1.2);
}

@keyframes panelIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

.panel__head {
  display: flex;
  align-items: center;
  gap: 12px;
}

.chip {
  min-width: 56px;
  height: 56px;
  padding: 0 10px;
  border-radius: 14px;
  background: #f2fbf7;
  border: 1px solid #dbe7e1;
  font-size: 24px;
  font-weight: 500;
  color: #123c31;
  text-align: center;
  line-height: 56px;
}

.panel__q {
  font-size: 22px;
  color: #6b8a80;
}

.panel__hint {
  font-size: 13px;
  color: #6b8a80;
  margin-top: 14px;
}

.panel__title {
  font-size: 20px;
  font-weight: 500;
  margin-bottom: 8px;
}

.panel__title.is-win {
  color: #0b8f6d;
}

.panel__title.is-lose {
  color: #b4553f;
}

.panel__expr {
  font-size: 15px;
  color: #6b8a80;
  margin-bottom: 6px;
}

.panel__row {
  display: flex;
  gap: 12px;
  margin-top: 18px;
}

.opbtn {
  width: 58px;
  height: 58px;
  border-radius: 16px;
  background: #f2fbf7;
  border: 1px solid #dbe7e1;
  font-size: 26px;
  font-weight: 500;
  color: #123c31;
  text-align: center;
  line-height: 58px;
}

.opbtn:active {
  background: #d9f2e7;
}

.panel__cancel {
  margin-top: 16px;
  font-size: 14px;
  color: #6b8a80;
}

.btn {
  padding: 12px 28px;
  border-radius: 999px;
  background: #0b8f6d;
  color: #ffffff;
  font-size: 15px;
  text-align: center;
}

.btn--ghost {
  background: #ffffff;
  color: #0b8f6d;
  border: 1px solid #0b8f6d;
}

/* ---------- 特效层 ---------- */

/* 全屏画布，只负责画，不接事件 */
.fx {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 200;
  pointer-events: none;
}

/* 非法操作 / 死局时牌桌轻微震一下 */
.is-shaking {
  animation: shake 0.42s ease-in-out;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  15% { transform: translateX(-5px); }
  30% { transform: translateX(5px); }
  45% { transform: translateX(-4px); }
  60% { transform: translateX(4px); }
  80% { transform: translateX(-2px); }
}
