<view class="shell">
  <view class="glow glow--a"></view>
  <view class="glow glow--b"></view>

  <view class="home" style="padding-top:{{topPad + 34}}px">

    <!-- 招牌 + 一句话玩法 -->
    <view class="home__brand">
      <view class="logo logo--lg">
        <view class="logo__half logo__half--mint"><text class="logo__t logo__t--lg">24</text></view>
        <view class="logo__half logo__half--warm"><text class="logo__t logo__t--lg logo__t--w">Game</text></view>
      </view>
      <text class="home__slogan">拖一张牌到另一张上 · 凑出 24</text>

      <view class="home__steps">
        <text class="home__step">拖牌</text>
        <text class="home__arrow">→</text>
        <text class="home__step">选运算符</text>
        <text class="home__arrow">→</text>
        <text class="home__step home__step--win">凑 24</text>
      </view>
    </view>

    <!-- 三张牌摆个扇形，直接告诉玩家这游戏长什么样 -->
    <view class="deck">
      <view class="deck__card deck__card--l card card--red">
        <view class="card__glow"></view>
        <view class="card__corner card__corner--tl">
          <text class="card__v">6</text><text class="card__s">♥</text>
        </view>
        <view class="card__center">6</view>
        <view class="card__corner card__corner--br">
          <text class="card__v">6</text><text class="card__s">♥</text>
        </view>
        <view class="card__edge"></view>
      </view>

      <view class="deck__card deck__card--r card">
        <view class="card__glow"></view>
        <view class="card__corner card__corner--tl">
          <text class="card__v">4</text><text class="card__s">♠</text>
        </view>
        <view class="card__center">4</view>
        <view class="card__corner card__corner--br">
          <text class="card__v">4</text><text class="card__s">♠</text>
        </view>
        <view class="card__edge"></view>
      </view>

      <view class="deck__card deck__card--f card">
        <view class="card__glow"></view>
        <view class="card__corner card__corner--tl">
          <text class="card__v">24</text><text class="card__s">♦</text>
        </view>
        <view class="card__center deck__win">24</view>
        <view class="card__corner card__corner--br">
          <text class="card__v">24</text><text class="card__s">♦</text>
        </view>
        <view class="card__edge"></view>
      </view>
    </view>

    <!-- 进度 + 大按钮 -->
    <view class="home__panel">
      <view class="progress">
        <view class="progress__row">
          <text class="progress__label">闯关进度</text>
          <text class="progress__num">{{cleared}} / {{total}}</text>
        </view>
        <view class="progress__track">
          <view class="progress__bar" style="width:{{pct}}%"></view>
        </view>
        <text class="progress__hint">第 {{nextNo}} 关 · {{tierName}} · 本档最佳 {{bestText}}</text>
      </view>

      <view class="cta" hover-class="is-press" bindtap="start">
        <text class="cta__main">{{allDone ? '重头再来' : '开始游戏'}}</text>
        <text class="cta__sub">{{allDone ? '300 关已经全通了' : '继续第 ' + nextNo + ' 关'}}</text>
      </view>

      <view class="home__row">
        <view class="tool home__tool" hover-class="is-press" bindtap="map">
          <view class="ico-grid home__ico">
            <view class="ico-grid__c"></view>
            <view class="ico-grid__c"></view>
            <view class="ico-grid__c"></view>
            <view class="ico-grid__c"></view>
          </view>
          <text class="tool__cap">关卡地图</text>
        </view>
        <view class="tool home__tool" hover-class="is-press" bindtap="openHelp">
          <text class="tool__ico">?</text>
          <text class="tool__cap">怎么玩</text>
        </view>
      </view>
    </view>

    <text class="home__foot">15 档 300 关 · 幼儿园 → 数学之王</text>
  </view>
</view>

<!-- 玩法说明 -->
<view class="modal" wx:if="{{showHelp}}" bindtap="closeHelp">
  <view class="modal__card" catchtap="noop">
    <view class="modal__title">怎么玩</view>
    <view class="howto">
      <view class="howto__li"><text class="howto__no">1</text><text class="howto__tx"><text class="b">拖动</text>一张牌，松手落到另一张牌上</text></view>
      <view class="howto__li"><text class="howto__no">2</text><text class="howto__tx">两张牌一合上，就在它们<text class="b">中点弹出一圈运算符</text>，选 + − × ÷</text></view>
      <view class="howto__li"><text class="howto__no">3</text><text class="howto__tx"><text class="b">合成</text>出一张新牌，原来两张合并消失</text></view>
      <view class="howto__li"><text class="howto__no">4</text><text class="howto__tx">把 4 张牌合到只剩 1 张，且结果为 <text class="b">24</text>，即获胜</text></view>
    </view>
    <view class="howto__tip">也可以<text class="b">依次点两张牌</text>。想反过来算（比如 5 − 7），把另一张牌拖过去就行。</view>
    <view class="modal__actions">
      <view class="btn btn--primary" hover-class="is-press" bindtap="closeHelp">明白了</view>
    </view>
  </view>
</view>
