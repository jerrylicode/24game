/* =========================================================
   levels.wxss —— 关卡地图
   一条横滑的档位药丸 + 一个可翻页的 5×4 格子盘
   ========================================================= */

/* 这一页要能整页滚动（小屏时格子盘放不下） */
.shell--page {
  height: auto;
  min-height: 100vh;
  overflow: visible;
}

.lvm {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 0 24rpx 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

/* ---------- 头部（就是自绘的导航条） ---------- */

.lvm__head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  /* 高度由 navH 内联给（和微信胶囊同高，内容自然居中） */
}

/* 返回：左侧，别和右上角胶囊挤在一起 */
.lvm__back {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  padding-bottom: 4rpx;
  color: var(--text-dim);
  background: linear-gradient(180deg, #ffffff, #f2fbf7);
  border: 1px solid var(--line);
  box-shadow: 0 3rpx 0 rgba(18, 49, 42, 0.08);
}

.lvm__title {
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  color: var(--text);
}

.lvm__prog {
  margin-left: auto;
  font-size: 26rpx;
  font-weight: 900;
  color: var(--coral-deep);
}

/* ---------- 总进度条 ---------- */

.lvm__bar {
  height: 12rpx;
  border-radius: 99rpx;
  background: #e4f1eb;
  overflow: hidden;
}

.lvm__bar-in {
  height: 100%;
  border-radius: 99rpx;
  background: linear-gradient(90deg, var(--mint-hi), var(--mint) 70%, #12bd8f);
  transition: width 0.4s cubic-bezier(0.22, 1.4, 0.36, 1);
}

/* ---------- 档位标签条 ---------- */

.lvm__tabs {
  width: 100%;
  white-space: nowrap;
}

.lvm__tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  margin-right: 10rpx;
  padding: 10rpx 20rpx 8rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ffffff, #f3fbf7);
  border: 1px solid var(--line);
  box-shadow: 0 3rpx 0 rgba(18, 49, 42, 0.06);
}

.lvm__tab-name {
  font-size: 23rpx;
  font-weight: 900;
  letter-spacing: 0.3rpx;
  color: var(--text-dim);
}

.lvm__tab-count {
  font-size: 19rpx;
  font-weight: 800;
  color: var(--text-3);
}

.lvm__tab.is-active {
  border-color: var(--amber-deep);
  background: linear-gradient(180deg, var(--amber-hi), var(--amber));
  box-shadow: 0 5rpx 0 var(--amber-deep);
}

.lvm__tab.is-active .lvm__tab-name {
  color: var(--ink);
}

.lvm__tab.is-active .lvm__tab-count {
  color: rgba(11, 42, 33, 0.72);
}

/* ---------- 档位页 ---------- */

/* 格子盘吃掉中间剩下的高度；盘里的「档位名 + 20 个格子」整体居中 */
.lvm__pager {
  flex: 1;
  min-height: 600rpx;
}

.lvm__page {
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 100%;
  padding: 4rpx 2rpx 0;
  box-sizing: border-box;
}

.lvm__page-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 0 2rpx 12rpx;
}

.lvm__page-name {
  font-size: 25rpx;
  font-weight: 900;
  color: var(--text);
}

.lvm__page-rule {
  font-size: 21rpx;
  color: var(--text-3);
}

.lvm__grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12rpx;
}

/* 格子：白瓷小方块，三种状态 */
.lvm__node {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 116rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text);
  background: linear-gradient(180deg, #ffffff, #f1faf6);
  border: 1px solid var(--line-2);
  transition: transform 0.12s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.lvm__node:active {
  transform: translateY(3rpx);
}

/* 已通关：薄荷底 */
.lvm__node.is-done {
  color: var(--mint-deep);
  background: linear-gradient(180deg, #e9fff7, #ccf6e6);
  border-color: rgba(23, 201, 154, 0.55);
}

/* 当前关：琥珀糖砖 + 呼吸 */
.lvm__node.is-current {
  color: var(--ink);
  background: linear-gradient(180deg, var(--amber-hi), var(--amber));
  border-color: var(--amber-deep);
  box-shadow: 0 4rpx 0 var(--amber-deep);
  animation: nodePulse 1.8s ease-in-out infinite;
}

@keyframes nodePulse {
  0%, 100% {
    box-shadow: 0 4rpx 0 var(--amber-deep);
  }
  50% {
    box-shadow: 0 4rpx 0 var(--amber-deep), 0 0 0 6rpx rgba(255, 194, 61, 0.28);
  }
}

/* 锁定：褪色 */
.lvm__node.is-lock {
  opacity: 0.4;
}

/* ---------- 底部 ---------- */

.lvm__foot {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.lvm__arrow {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--text-dim);
  background: linear-gradient(180deg, #ffffff, #f2fbf7);
  border: 1px solid var(--line);
  box-shadow: 0 3rpx 0 rgba(18, 49, 42, 0.08);
}

.lvm__arrow.is-off {
  opacity: 0.35;
}

.lvm__note {
  flex: 1;
  text-align: center;
  font-size: 21rpx;
  color: var(--text-3);
}
