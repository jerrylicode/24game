<view class="page" style="padding-top:{{topPad}}px">

  <view class="head">
    <view class="head__title">24Game</view>
    <view class="head__sub">拖两张牌合成 24 点 · 15 档 300 关</view>
    <view class="bar">
      <view class="bar__fill" style="width:{{pct}}%"></view>
    </view>
    <view class="head__stat">已通关 {{cleared}} / {{total}}　{{pct}}%</view>
  </view>

  <scroll-view class="list" scroll-y>
    <view class="tier" wx:for="{{tiers}}" wx:for-item="tier" wx:for-index="ti" wx:key="i">
      <view class="tier__head">
        <view class="tier__title">
          <text class="tier__name">{{tier.name}}</text>
          <text class="tier__rule">{{tier.rule === 'int' ? '整数' : '含分数'}}</text>
        </view>
        <text class="tier__done {{tier.done === 20 ? 'is-full' : ''}}">{{tier.done}}/20</text>
      </view>
      <view class="tier__note">{{tier.note}}</view>
      <view class="grid">
        <view
          wx:for="{{tier.levels}}"
          wx:for-item="lv"
          wx:for-index="li"
          wx:key="gi"
          class="cell cell--{{lv.state}}"
          data-gi="{{lv.gi}}"
          data-state="{{lv.state}}"
          bindtap="pick"
        >
          <text class="cell__n">{{lv.label}}</text>
        </view>
      </view>
    </view>

    <view class="foot">一共 300 关，慢慢来</view>
  </scroll-view>

</view>
