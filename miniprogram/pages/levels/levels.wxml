<view class="shell shell--page">
  <view class="glow glow--a"></view>
  <view class="glow glow--b"></view>

  <view class="lvm" style="padding-top:{{topPad}}px">

    <!-- 头部：标题 + 总进度 + 关闭 -->
    <view class="lvm__head">
      <text class="lvm__title">闯关</text>
      <text class="lvm__prog">{{cleared}} / {{total}}</text>
      <view class="lvm__close" hover-class="is-press" bindtap="back">✕</view>
    </view>

    <view class="lvm__bar">
      <view class="lvm__bar-in" style="width:{{pct}}%"></view>
    </view>

    <!-- 档位标签：横向可滑，点一下直接跳档 -->
    <scroll-view
      class="lvm__tabs"
      scroll-x
      scroll-with-animation
      scroll-into-view="tab-{{active}}"
    >
      <view
        wx:for="{{tiers}}"
        wx:key="i"
        id="tab-{{index}}"
        class="lvm__tab {{active === index ? 'is-active' : ''}}"
        data-i="{{index}}"
        bindtap="pickTab"
      >
        <text class="lvm__tab-name">{{item.name}}</text>
        <text class="lvm__tab-count">{{item.done}}/20</text>
      </view>
    </scroll-view>

    <!-- 档位页：左右滑动切换，每页 5×4 = 20 关 -->
    <swiper
      class="lvm__pager"
      current="{{active}}"
      bindchange="onSwiper"
      duration="260"
    >
      <swiper-item wx:for="{{tiers}}" wx:key="i">
        <view class="lvm__page">
          <view class="lvm__page-head">
            <text class="lvm__page-name">{{item.name}}</text>
            <text class="lvm__page-rule">{{item.rule}}</text>
          </view>

          <view class="lvm__grid">
            <view
              wx:for="{{item.levels}}"
              wx:for-item="lv"
              wx:key="gi"
              class="lvm__node is-{{lv.state}}"
              data-gi="{{lv.gi}}"
              data-state="{{lv.state}}"
              bindtap="pick"
            >{{lv.label}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 底部：上一档 / 提示 / 下一档 -->
    <view class="lvm__foot">
      <view class="lvm__arrow {{active === 0 ? 'is-off' : ''}}" hover-class="is-press" bindtap="prev">‹</view>
      <text class="lvm__note">左右滑动切换档位 · 点格子进关</text>
      <view class="lvm__arrow {{active === 14 ? 'is-off' : ''}}" hover-class="is-press" bindtap="next">›</view>
    </view>
  </view>
</view>
